{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/predict-intent",
      "dest": "api/index.py"
    },
    {
      "src": "/rank-content",
      "dest": "api/index.py"
    },
    {
      "src": "/log-event",
      "dest": "api/index.py"
    },
    {
      "src": "/friction-heatmap",
      "dest": "api/index.py"
    },
    {
      "src": "/session-value-score",
      "dest": "api/index.py"
    },
    {
      "src": "/content-pool",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/docs",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
